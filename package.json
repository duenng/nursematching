{
  "name": "carekoala",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "format": "prettier --write src tests server scripts *.ts *.json *.html docs/*.md README.md",
    "test:workflow": "node --experimental-sqlite --test server/*.test.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^6.3.6"
  },
  "overrides": {
    "serve": {
      "compression": "^1.8.2"
    }
  }
}
