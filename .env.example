# npm run dev / npm start load .env automatically.
BASE_URL=http://localhost:5173
WORKFLOW_DB=data/workflow.sqlite
WORKFLOW_ADMIN_KEY=
AUTH_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_ADMIN_EMAILS=
STAFF_SENIOR_NURSE_EMAILS=
# Leave SMTP_HOST blank to capture messages locally.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# All SMTP recipients must be included, comma-separated.
TEST_EMAIL_ALLOWLIST=
# Customer transfers manually; staff independently verify bank receipts.
PAYMENT_MODE=bank_transfer
# Leave blank until the receiving bank account is available.
# Missing details block acceptance of new payment bookings.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# Legacy test alternatives only; unused in bank_transfer mode.
FPS_TEST_RECIPIENT=
FPS_TEST_ACCOUNT_NAME=
STRIPE_SECRET_KEY=
# Disabled in bank_transfer mode.
ENABLE_TEST_CLOCK=false
