# npm run dev / npm start load .env automatically.
BASE_URL=http://localhost:5173
# When frontend and API are separate, BASE_URL is the backend public URL.
# Set FRONTEND_URL/CORS_ORIGINS to the exact frontend origin.
FRONTEND_URL=
CORS_ORIGINS=
WORKFLOW_DB=data/workflow.sqlite
WORKFLOW_ADMIN_KEY=
AUTH_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_ADMIN_EMAILS=
STAFF_SENIOR_NURSE_EMAILS=
# Leave SMTP_HOST blank to capture messages locally.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Test mode only: permitted SMTP recipients, comma-separated. Ignored in live mode.
TEST_EMAIL_ALLOWLIST=
# Customer transfers manually; staff independently verify bank receipts.
PAYMENT_MODE=bank_transfer
# Leave blank until the receiving bank account is available.
# Missing details block acceptance of new payment bookings.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# Legacy test alternatives only; unused in bank_transfer mode.
FPS_TEST_RECIPIENT=
FPS_TEST_ACCOUNT_NAME=
STRIPE_SECRET_KEY=
# Disabled in bank_transfer mode.
ENABLE_TEST_CLOCK=false
# Staff pages use server records. Test data and simulated payments require test.
WORKSPACE_MODE=live
# Live mode does not restrict recipients using TEST_EMAIL_ALLOWLIST.
# In test mode, the allowlist is mandatory for every SMTP recipient.
# Optional AI enquiry assistant. Server-only; never use a VITE_ prefix for keys.
# Without a key, families can still submit their description for staff follow-up.
INTAKE_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_INTAKE_MODEL=openrouter/free
# Optional alternative: set INTAKE_AI_PROVIDER=openai to use OpenAI.
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=gpt-4.1-mini
